# From Waveshare's own LVGL example for this board, less its demos.
# Flash is stated as 16 MB, the size the plain 1.75 documents; the example says
# 32 MB for the C. The first serial log prints what the chip actually has.
# QIO, though the build's flash arguments say dio: ESP-IDF writes dio into the
# image header and its bootloader switches the flash to quad itself.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
# Waveshare's example takes 64 KB of data cache; the cache is carved from the
# same internal SRAM as the heap, and on the board the screen and Wi-Fi did not
# fit beside it. 32 KB gives the other 32 back; her frame times in the serial
# log say what it costs her drawing.
CONFIG_ESP32S3_DATA_CACHE_32KB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

CONFIG_FREERTOS_HZ=1000
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_OBJ_STYLE_CACHE=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# The setup's code on her screen.
CONFIG_LV_USE_QRCODE=y

# TLS for her door: its buffers in PSRAM, where the internal RAM the screen
# needs is not.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# And its AES in software: the AES peripheral reads by DMA, so with the TLS
# buffers in PSRAM it copies through internal DMA memory, which on the board
# was not there ("esp-aes: Failed to allocate memory") and no key could be
# checked. A handshake's AES is a few kilobytes; the processor does it.
CONFIG_MBEDTLS_HARDWARE_AES=n
# Wi-Fi's and lwIP's buffers in PSRAM too: on the first board they left so
# little internal RAM that the setup's web server could not start.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# And Wi-Fi's hot code out of internal RAM, which it then cannot start
# without: ESP-IDF's RAM guide gives the cost as Wi-Fi speed, and hers
# carries only a recording and a voice.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
# Eight fixed receive buffers, not the sixteen ESP-IDF takes once Wi-Fi
# prefers PSRAM: they are DMA buffers and stay internal, 1.6 KB each, and on
# the board Wi-Fi then could not allocate its own small frames ("wifi:m f
# null"). The dynamic ones behind them are in PSRAM.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
# Her task's 40 KB stack in PSRAM (main.c): ESP-IDF's external-RAM guide allows
# a stack there with this option, given through xTaskCreateStatic.
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y

# An update that never reaches her Wi-Fi is rolled back by the bootloader.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
